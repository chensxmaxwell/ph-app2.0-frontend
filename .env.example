# Leave empty (or localhost) to use the on-device GraphQL backend.
# Only a non-localhost https URL talks to a remote server.
BACKEND_URL=
AWS_ACCESS_KEY=AAAAAAAAAAAAAAAA
AWS_SECRET_KEY=AAS567192321ASDAD
LLM_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=deepseek-v4-flash-ga-260731
# Cloud voice (豆包语音合成 / Doubao Seed-TTS 2.0). The speech console issues its
# own API key at console.volcengine.com/speech/new/setting/apikeys; the Ark
# LLM key above is NOT accepted there (the app still tries it once and falls
# back to on-device voices). Legacy apps: TTS_APP_ID + TTS_ACCESS_TOKEN.
TTS_API_KEY=
TTS_APP_ID=
TTS_ACCESS_TOKEN=
